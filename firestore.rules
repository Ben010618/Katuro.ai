rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── Teacher documents (own data only, or admin) ─────────────────────────
    // create is intentionally blocked for all clients — teacher documents are
    // only ever created by the registerUser Cloud Function (Admin SDK), which
    // bypasses these rules. This prevents rogue registrations via REST API.
    // Account-control fields only an admin (or a Cloud Function) may change.
    // Without this, a teacher could grant themselves a Subscription or admin rights.
    function protectedTeacherFields() {
      return ['isAdmin', 'access', 'disabled', 'pendingApproval', 'tokenBalance',
              'deactivatedForInactivityAt', 'createdBy', '_registeredViaFunction'];
    }

    match /teachers/{userId} {
      allow read:   if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if false;
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedTeacherFields()))
      );
      allow delete: if false;
    }
    // Teachers own their subcollections, except the server-kept ledgers:
    // usage (daily AI limits), accessLogs (plan history), tokenLogs (legacy) — read-only to them.
    match /teachers/{userId}/{sub}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && !(sub in ['usage', 'accessLogs', 'tokenLogs']))
      );
    }

    // ── Admin config — API key lives here, BLOCKED from regular users ───────
    // billing doc holds the global "free for everyone" promo switch — every teacher reads it
    match /adminConfig/billing {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
    // announcement doc is the admin's broadcast to every teacher — readable by
    // any signed-in user, writable only by an admin. Must be listed BEFORE the
    // catch-all below, which is admin-only read.
    match /adminConfig/announcement {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
    match /adminConfig/{doc} {
      allow read, write: if isAdmin();
    }
    // Backup-engine answers per day: written only by generateAI; admins can see the count.
    match /aiBackupUsage/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── AI error reports — any auth user submits; admin reads/resolves ────────
    match /aiErrorReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ── Feedback inbox — any auth user submits; admin reads/replies/deletes ──
    // The original submitter may also read their own entries (to see a
    // reply) and flip replyRead on their own entry (to clear their own
    // unread badge) -- nothing else about the doc is theirs to touch.
    match /feedback_inbox/{feedbackId} {
      allow create: if request.auth != null &&
        request.resource.data.createdBy.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
      allow read: if request.auth != null && resource.data.createdBy.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.createdBy.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyRead']);
    }

    // ── Feature requests — public read (curated board); admin-only writes ──
    match /feature_requests/{requestId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ── Usage analytics — any auth user logs their own events; admin reads all ──
    // BUG-FIX: Added field-count cap (size() <= 10) to prevent any authenticated
    // user from flooding the collection with arbitrarily large documents, which
    // would pollute analytics charts and inflate Firestore costs. The largest
    // valid event shape from usageTracker.js has at most 7 fields (uid, feature,
    // ts, tool, success, durationMs, error), so 10 gives comfortable headroom.
    match /usageEvents/{docId} {
      allow create: if request.auth != null && request.resource.data.size() <= 10;
      allow read: if isAdmin();
    }

    // ── Shared plan snapshots — public read (no auth), Cloud Function writes ──
    match /sharedPlans/{shareId} {
      allow read:  if true;
      allow write: if false; // Admin SDK only
    }

    // ── KaTuro Collab: channels ────────────────────────────────────────────
    match /collabChannels/{channelId} {
      allow read: if request.auth != null && (
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.members
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.members ||
        resource.data.createdBy == request.auth.uid
      );
      match /messages/{msgId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // ── KaTuro Collab: direct messages ────────────────────────────────────
    match /collabDMs/{dmId} {
      allow read, update: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      match /messages/{msgId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // ── Admin notifications — any auth user can create (e.g. on self-signup); admin reads/updates ──
    match /adminNotifications/{notifId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ── Deletion logs — audit trail for the inactivity cleanup job. Admin
    // SDK (Cloud Functions) bypasses these rules to write; no client, not
    // even an admin, may write here — it's a record of what happened, not
    // something to edit.
    match /deletionLogs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── kaTuro Protect — child protection decision-support module ───────────
    // BrainBank access model calls for role/schoolId scoping (school_head,
    // cpc_member, guidance, lfo) — that role system doesn't exist in this app
    // yet (only isAdmin). The tool itself (Chat, Intake) is open to all
    // authenticated teachers; case DATA stays admin-only — a teacher can file
    // a report but not browse other people's cases. Tighten further once a
    // real role system exists.
    match /protect_chunks/{chunkId} {
      allow read, write: if isAdmin();
    }
    match /protect_cases/{caseId} {
      // Any authenticated teacher can file a new report via Intake, and can
      // read back their own filed cases (Filed Cases tab) — but not anyone
      // else's. Only admins can read the full Case Board or modify/advance
      // an existing case (state transitions, archiving).
      allow create: if request.auth != null;
      allow read: if isAdmin() || resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /protect_chat_sessions/{sessionId} {
      allow read, write: if isAdmin();
    }
    match /incident_registry/{learnerCode} {
      allow read, write: if isAdmin();
    }
    // Real-name <-> code-name mapping — kept separate from incident_registry
    // per BrainBank Part L2 so a coded record alone never re-identifies a
    // learner. Same admin-only gate; no client, including the case UI, should
    // ever bulk-read this collection.
    match /protect_identities/{learnerCode} {
      allow read, write: if isAdmin();
    }
    match /referral_contacts/{officeId} {
      // Any authenticated teacher can read contacts (needed for their own
      // Filed Cases' Next-Move Card); only admins manage/edit the directory.
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Audit trail of every protect_* read/write/export — Cloud Functions
    // write via Admin SDK; no client writes, matching deletionLogs above.
    match /protect_audit_logs/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Presentation caches (Cloud Functions write via Admin SDK) ───────────
    match /presentationOutlineCache/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /presentationSlideCache/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── kaTuro Shares ─────────────────────────────────────────────────────────

    match /shares_posts/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      // Authors can update/delete freely; anyone auth can increment reactions + commentCount
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorUid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reactions', 'commentCount', 'updatedAt'])
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorUid || isAdmin()
      );

      match /comments/{commentId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        // Authors edit/delete; anyone auth can increment replyCount
        allow update: if request.auth != null && (
          request.auth.uid == resource.data.authorUid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        );
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorUid || isAdmin()
        );

        match /replies/{replyId} {
          allow read:   if request.auth != null;
          allow create: if request.auth != null;
          allow delete: if request.auth != null && (
            request.auth.uid == resource.data.authorUid || isAdmin()
          );
        }
      }
    }

    match /shares_reactions/{postId} {
      allow read, write, delete: if request.auth != null && isAdmin();
      match /userReactions/{uid} {
        allow read:          if request.auth != null;
        allow write, delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
      }
    }

    match /shares_profiles/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // A follower may move YOUR followerCount by exactly 1, matching their own
      // follower entry (following used to fail halfway: this write was refused).
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) && (
          (request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1 &&
            exists(/databases/$(database)/documents/shares_follows/$(uid)/followers/$(request.auth.uid))) ||
          (request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1 &&
            !exists(/databases/$(database)/documents/shares_follows/$(uid)/followers/$(request.auth.uid)))
        );
    }

    match /shares_follows/{uid}/{sub}/{targetUid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Your own entry in someone else's followers list.
    match /shares_follows/{uid}/followers/{followerUid} {
      allow create, delete: if request.auth != null && request.auth.uid == followerUid;
    }

    match /shares_notifications/{uid}/items/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow create:      if request.auth != null; // other users write notifications to your inbox
    }


    // ── Messages: usernames, directory, chats (Phase 1, 2026-10-04) ──────────
    // Teachers message teachers from the same school or division. Usernames and
    // directory cards are written only by the claimUsername / syncDirectory
    // functions. The kaTuro admin can read every chat (teachers are told so).
    function myDir() {
      return get(/databases/$(database)/documents/directory/$(request.auth.uid)).data;
    }
    function hasDir() {
      return request.auth != null && exists(/databases/$(database)/documents/directory/$(request.auth.uid));
    }
    function sameOrgWith(otherUid) {
      let a = myDir();
      let b = get(/databases/$(database)/documents/directory/$(otherUid)).data;
      return (a.divisionKey != '' && a.divisionKey == b.divisionKey) ||
             (a.schoolKey != '' && a.schoolKey == b.schoolKey);
    }
    function isChatMember(cid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/conversations/$(cid)/chatMembers/$(request.auth.uid));
    }
    function isChatAdmin(cid) {
      return isChatMember(cid) &&
        get(/databases/$(database)/documents/conversations/$(cid)/chatMembers/$(request.auth.uid)).data.role == 'admin';
    }
    function validTeamName(n) {
      return n is string && n.size() > 0 && n.size() <= 60;
    }
    // Either teacher of a pair has blocked the other (Phase 2: one-to-one chats only).
    function blockedPair(a, b) {
      return exists(/databases/$(database)/documents/chatBlocks/$(a)/blocked/$(b)) ||
             exists(/databases/$(database)/documents/chatBlocks/$(b)/blocked/$(a));
    }
    function dmBlocked(cid) {
      let c = get(/databases/$(database)/documents/conversations/$(cid)).data;
      return c.type == 'dm' && blockedPair(c.members[0], c.members[1]);
    }

    match /usernames/{name} {
      allow get:          if request.auth != null;   // "is this username free?"
      allow list, write:  if false;                  // no browsing; claimed by the server only
    }

    match /directory/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || isAdmin() ||
        (hasDir() && myDir().divisionKey != '' && resource.data.divisionKey == myDir().divisionKey) ||
        (hasDir() && myDir().schoolKey != '' && resource.data.schoolKey == myDir().schoolKey)
      );
      allow write: if false;
    }

    match /conversations/{cid} {
      allow read: if isChatMember(cid) || isAdmin();
      allow create: if hasDir() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.lastMessage == null && (
          (request.resource.data.type == 'team' &&
            validTeamName(request.resource.data.name) &&
            request.resource.data.keys().hasOnly(['type', 'name', 'createdBy', 'createdAt', 'lastMessage', 'lastMessageAt'])) ||
          (request.resource.data.type == 'dm' &&
            request.resource.data.members is list &&
            request.resource.data.members.size() == 2 &&
            request.resource.data.members[0] < request.resource.data.members[1] &&
            request.auth.uid in request.resource.data.members &&
            cid == 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1] &&
            !blockedPair(request.resource.data.members[0], request.resource.data.members[1]) &&
            sameOrgWith(request.resource.data.members[0] == request.auth.uid
              ? request.resource.data.members[1] : request.resource.data.members[0]) &&
            request.resource.data.keys().hasOnly(['type', 'members', 'createdBy', 'createdAt', 'lastMessage', 'lastMessageAt']))
        );
      allow update: if isChatMember(cid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt']) &&
          request.resource.data.lastMessageAt == request.time &&
          request.resource.data.lastMessage.senderUid == request.auth.uid) ||
        (resource.data.type == 'team' && isChatAdmin(cid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          validTeamName(request.resource.data.name))
      );
      allow delete: if false;

      match /chatMembers/{memberUid} {
        allow read: if isChatMember(cid) || isAdmin();
        allow create: if request.auth != null &&
          request.resource.data.uid == memberUid &&
          request.resource.data.addedBy == request.auth.uid &&
          request.resource.data.joinedAt == request.time &&
          request.resource.data.keys().hasOnly(['uid', 'role', 'addedBy', 'joinedAt']) && (
            // The creator joins their new team as its admin (same batch that creates it).
            (memberUid == request.auth.uid && request.resource.data.role == 'admin' &&
              !exists(/databases/$(database)/documents/conversations/$(cid)) &&
              getAfter(/databases/$(database)/documents/conversations/$(cid)).data.type == 'team' &&
              getAfter(/databases/$(database)/documents/conversations/$(cid)).data.createdBy == request.auth.uid) ||
            // Both people of a new one-to-one chat, written by the person starting it.
            (request.resource.data.role == 'member' &&
              !exists(/databases/$(database)/documents/conversations/$(cid)) &&
              getAfter(/databases/$(database)/documents/conversations/$(cid)).data.type == 'dm' &&
              getAfter(/databases/$(database)/documents/conversations/$(cid)).data.createdBy == request.auth.uid &&
              memberUid in getAfter(/databases/$(database)/documents/conversations/$(cid)).data.members) ||
            // A team admin adds a teacher from the same school or division.
            (request.resource.data.role == 'member' && memberUid != request.auth.uid &&
              get(/databases/$(database)/documents/conversations/$(cid)).data.type == 'team' &&
              isChatAdmin(cid) && sameOrgWith(memberUid))
          );
        // A team admin may make another member an admin (e.g. before leaving).
        allow update: if isChatAdmin(cid) &&
          get(/databases/$(database)/documents/conversations/$(cid)).data.type == 'team' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          request.resource.data.role in ['admin', 'member'];
        allow delete: if request.auth != null &&
          get(/databases/$(database)/documents/conversations/$(cid)).data.type == 'team' && (
            request.auth.uid == memberUid ||                       // leave a team
            (memberUid != request.auth.uid && isChatAdmin(cid))     // an admin removes a member
          );
      }

      match /messages/{messageId} {
        allow read: if isChatMember(cid) || isAdmin();
        allow create: if isChatMember(cid) &&
          request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'text', 'createdAt']) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderName == myDir().displayName &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.createdAt == request.time &&
          !dmBlocked(cid);
        // Deleting your own message blanks it ("message deleted"); nothing else changes.
        allow update: if request.auth != null &&
          resource.data.senderUid == request.auth.uid &&
          !('attachment' in resource.data) &&   // file messages: deleteChatMessage removes the file too
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted']) &&
          request.resource.data.deleted == true &&
          request.resource.data.text == '';
        allow delete: if false;
      }

      // "Media, files and links" of a chat. Media and files are written only by the
      // uploadChatFile function; links by the sender together with their message.
      match /media/{assetId} {
        allow read: if isChatMember(cid) || isAdmin();
        allow write: if false;
      }
      match /files/{assetId} {
        allow read: if isChatMember(cid) || isAdmin();
        allow write: if false;
      }
      match /links/{linkId} {
        allow read: if isChatMember(cid) || isAdmin();
        allow create: if isChatMember(cid) &&
          request.resource.data.keys().hasOnly(['url', 'domain', 'messageId', 'senderUid', 'senderName', 'createdAt']) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.url is string && request.resource.data.url.size() <= 2000 &&
          request.resource.data.url.matches('^https?://.+') &&
          request.resource.data.domain is string && request.resource.data.domain.size() <= 255 &&
          request.resource.data.senderName == myDir().displayName &&
          !dmBlocked(cid) &&
          // Only together with a brand-new message of the sender (same batch).
          !exists(/databases/$(database)/documents/conversations/$(cid)/messages/$(request.resource.data.messageId)) &&
          getAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(request.resource.data.messageId)).data.senderUid == request.auth.uid;
        allow update, delete: if false;   // removed by deleteChatMessage
      }
    }

    // Teachers you blocked (only you see or change your list).
    match /chatBlocks/{uid}/blocked/{otherUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Each teacher's list of chats (and when they last read each one).
    match /chatInbox/{uid}/chats/{cid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['cid', 'type', 'addedAt', 'lastReadAt']) &&
        request.resource.data.cid == cid &&
        existsAfter(/databases/$(database)/documents/conversations/$(cid)/chatMembers/$(uid)) && (
          request.auth.uid == uid ||
          getAfter(/databases/$(database)/documents/conversations/$(cid)/chatMembers/$(uid)).data.addedBy == request.auth.uid
        );
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt', 'muted']) &&
        (!('muted' in request.resource.data) || request.resource.data.muted is bool);
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        (!existsAfter(/databases/$(database)/documents/conversations/$(cid)/chatMembers/$(uid)) && isChatAdmin(cid))
      );
    }

    // Reported messages: any member reports; only the admin reads them.
    match /chatReports/{reportId} {
      allow create: if request.auth != null &&
        isChatMember(request.resource.data.cid) &&
        request.resource.data.keys().hasOnly(['cid', 'messageId', 'reporterUid', 'reason', 'messageText', 'senderUid', 'senderName', 'createdAt', 'status']) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.reason is string && request.resource.data.reason.size() <= 500 &&
        get(/databases/$(database)/documents/conversations/$(request.resource.data.cid)/messages/$(request.resource.data.messageId)).data.senderUid == request.resource.data.senderUid;
      allow read, update, delete: if isAdmin();
    }

  }
}
