# Copy this file to .env and fill in your keys.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Google Gemini API key for KaTuro AI Web (Lesson Plans, Quizzes, DLL, COT, AR)
VITE_GEMINI_API_KEY=your_gemini_api_key_for_katuro_web_here

# Dedicated Google Gemini API key for KaTuroDesk Desktop (Co-Teacher Studio, Item Analysis, Remediation, e-Class Records)
VITE_KATURO_DESK_GEMINI_KEY=your_gemini_api_key_for_katurodesk_here

# OpenRouter — general (quiz AI)
VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# NVIDIA NIM API key (PowerPoint lesson presentation generation & AI visuals)
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
VITE_NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-xl

