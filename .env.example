# Copy this file to .env and fill in your keys.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Google Gemini API key (quiz builder, etc.)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter — general (quiz AI)
VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# OpenRouter — ILAW lesson gen (two separate quota keys)
VITE_OR_UNPACK_KEY=your_openrouter_unpack_key_here
VITE_OR_GEN_KEY=your_openrouter_gen_key_here
