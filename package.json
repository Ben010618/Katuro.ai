{
  "name": "katuro-ai",
  "private": true,
  "version": "1.8.7",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "electron .",
    "electron:build": "vite build --mode desk && node scripts/bundle-desk-updater.mjs && electron-builder --win",
    "test:rules": "firebase emulators:exec --only firestore --project katuro-rules-test \"vitest run tests/firestoreRules.test.js tests/messagesRules.test.js\"",
    "desk:dist": "vite build --mode desk && node scripts/bundle-desk-updater.mjs && electron-builder --win --publish never",
    "test:e2e:messages": "firebase emulators:exec --only auth,firestore,functions,storage --project demo-katuro \"vitest run tests/messages.e2e.test.js\"",
    "test:e2e:email": "firebase emulators:exec --only auth,firestore,functions --project demo-katuro \"vitest run tests/emailCode.e2e.test.js\""
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "docx": "^9.6.1",
    "docxtemplater": "^3.71.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pizzip": "^3.3.0",
    "pptxgenjs": "^4.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.9.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "ai.katuro.desk",
    "productName": "KaTuroDesk",
    "directories": {
      "output": "C:/Users/USER/KaTuroDesk-Dist",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs",
      "dependencies": {}
    },
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KaTuroDesk",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "KaTuroDesk-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ben010618",
        "repo": "Katuro.ai",
        "releaseType": "release"
      }
    ]
  }
}
