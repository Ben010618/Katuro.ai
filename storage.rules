rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each teacher can only read/write their own folder
    match /teachers/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Profile photos — any auth user can read, only owner can write
    match /profilePhotos/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // kaTuro Shares post photos — any auth user can read, only uploader can write
    match /shares/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
